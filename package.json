{
  "name": "dsh-bird-bike",
  "version": "1.2.2",
  "type": "module",
  "description": "A helmeted pixel chicken rides a bicycle through a Minecraft-style strip docked at the bottom of the DSH web app frame.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blackstar-baba/dsh-bird-bike.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "pixel-art",
    "canvas"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.zh-CN.md",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
